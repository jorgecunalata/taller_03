# H200 de la USFQ (VPN GlobalProtect). No pongas secretos reales en el repo.
H200_HOST=172.28.230.10
H200_LLM_PORT=12555
H200_EMBED_PORT=11434
H200_API_KEY=local

# auto: intenta la H200 y cae a simulated si no hay VPN.
# simulated | h200
LLM_BACKEND=auto

# Thinking+tools en vLLM suele quemar MAX_PASOS. Déjalo en 0 salvo depuración.
H200_ENABLE_THINKING=0

# Árbol Java junto a este repo en el Mac del estudiante.
# Preferido si demo_ats es hermano del repo (no symlink):
# DEMO_ATS=../demo_ats
# o absoluto:
# DEMO_ATS=/Users/jcunalata/Documents/ia_generativa_agentes/taller_3/demo_ats
DEMO_ATS=./demo_ats

QDRANT_URL=http://localhost:6333
COLLECTION_DOCS=documentos
COLLECTION_CODE=montran_code

# Embeddings CAG (index-code / retrieve code):
#   auto  — H200 Ollama bge-m3 :11434; si no hay VPN, intenta sentence-transformers local
#   h200  — solo H200 (corrida calificable)
#   local — solo sentence-transformers BAAI/bge-m3 (pip install sentence-transformers torch)
EMBEDDING_BACKEND=auto

MAX_PASOS=20
MAX_REPLAN=2
TOKEN_BUDGET=80000
QUERY_FACTS_ROW_LIMIT=50

# Presupuesto de rondas tool por rol (corta thrashing H200).
TOOL_BUDGET_PLANNER=2
TOOL_BUDGET_READER=1
TOOL_BUDGET_WRITER=1
TOOL_BUDGET_VERIFIER=2
TOOL_BUDGET_SYNTHESIZER=0
